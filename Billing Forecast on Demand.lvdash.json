{
  "datasets": [
    {
      "name": "abe54cb0",
      "displayName": "revenue prediction",
      "queryLines": [
        "WITH\r\n",
        "aggregated AS (\r\n",
        "  SELECT\r\n",
        "    jeffdemo.dlife.v_billing_document_item_02.Billingdate AS BillingDate,\r\n",
        "    SUM(jeffdemo.dlife.v_billing_document_item_02.`sum(netamount)`) AS Revenue,\r\n",
        "    count(DISTINCT jeffdemo.dlife.v_billing_document_item_02.BillingDocument) as countb\r\n",
        "  FROM jeffdemo.dlife.v_billing_document_item_02\r\n",
        "  GROUP BY\r\n",
        "    1\r\n",
        ")\r\n",
        "SELECT Billingdate, Revenue_forecast , 0 as Revenue_actual, 0 as Revenue_on_date, 0 as Document_count_on_date FROM AI_FORECAST(\r\n",
        "  TABLE(aggregated),\r\n",
        "  horizon =>  :param + 1,\r\n",
        "  time_col => 'BillingDate',\r\n",
        "  value_col => 'Revenue'\r\n",
        ")\r\n",
        "union ALL\r\n",
        "  SELECT\r\n",
        "    Billingdate AS BillingDate,\r\n",
        "    0 as Revenue_forecast,\r\n",
        "    SUM(`sum(netamount)`) AS Revenue_actual,\r\n",
        "     0 as Revenue_on_date, 0 as Document_count_on_date\r\n",
        "  FROM  jeffdemo.dlife.v_billing_document_item_02\r\n",
        "   where Billingdate <= current_date() and Billingdate >= concat(year(current_date()),'-01-01')\r\n",
        "  GROUP BY\r\n",
        "    1\r\n",
        "union ALL\r\n",
        "SELECT BillingDate, 0 as Revenue_forecast,  0 as Revenue_actual, Revenue_forecast as Revenue_on_date, 0 as Document_count_on_date FROM AI_FORECAST(\r\n",
        "  TABLE(aggregated),\r\n",
        "  horizon =>  :param + 1,\r\n",
        "  time_col => 'BillingDate',\r\n",
        "  value_col => 'Revenue'\r\n",
        ") \r\n",
        "where to_date(BillingDate, 'MMM DD, YYYY') = :param\r\n",
        "union ALL\r\n",
        "SELECT BillingDate, 0 as Revenue_forecast,  0 as Revenue_actual, 0 as Revenue_on_date, cast(countb_forecast as int) as Document_count_on_date FROM AI_FORECAST(\r\n",
        "  TABLE(aggregated),\r\n",
        "  horizon =>  :param + 1,\r\n",
        "  time_col => 'BillingDate',\r\n",
        "  value_col => 'countb'\r\n",
        ") \r\n",
        "where to_date(BillingDate, 'MMM DD, YYYY') = :param\r\n"
      ],
      "parameters": [
        {
          "displayName": "Forecast_Date",
          "keyword": "param",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2025-10-12T00:00:00.000"
                }
              ]
            }
          }
        }
      ]
    }
  ],
